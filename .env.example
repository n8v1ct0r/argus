# Copy to .env.local and fill in. Never commit .env.local.

# Claude API key, read only by src/model/ on the server.
ANTHROPIC_API_KEY=

# Event store. Local file by default; a libsql:// URL plus token for hosted Turso.
DATABASE_URL=file:./data/argus.db
DATABASE_AUTH_TOKEN=

# Shared secret the ingest worker sends to /api/brief/run.
ARGUS_SCHEDULER_SECRET=

# replay: never call the model, serve recorded outputs (capture, CI, e2e). live: normal.
MODEL_MODE=live
